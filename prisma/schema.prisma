generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id              String    @id @default(cuid())
  slug            String    @unique
  shortCode       String?   @unique
  title           String
  excerpt         String
  content         String
  coverImage      String?
  coverImageAlt   String?
  metaTitle       String?
  metaDescription String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  viewCount       Int       @default(0)
  featured        Boolean   @default(false)
  readingMinutes  Int       @default(3)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  tags ArticleTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt])
  @@index([categoryId])
  @@index([featured])
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String  @unique
  description String?
  color       String  @default("#f97316")
  order       Int     @default(0)

  articles Article[]
  posts    Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String @unique

  articles ArticleTag[]
  posts    PostTag[]

  createdAt DateTime @default(now())
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

// ─────────────────────────────────────────────────────────────
// Comunidad: posts generados por usuarios (memes, confesiones, notas)
// ─────────────────────────────────────────────────────────────

enum PostType {
  MEME
  CONFESSION
  NOTE
}

enum ModStatus {
  PUBLISHED
  PENDING
  REMOVED
}

model Post {
  id           String    @id @default(cuid())
  type         PostType
  status       ModStatus @default(PUBLISHED)
  slug         String    @unique
  title        String? // confesión/nota: título; meme: caption opcional
  body         String? // texto de confesión/nota
  imageUrl     String? // ruta local del meme (/uploads/..)
  imageWidth   Int? // dimensiones capturadas al subir (para next/image)
  imageHeight  Int?
  authorName   String    @default("Anónimo")
  authorToken  String // id anónimo del navegador (dueño)
  score        Int       @default(0) // denormalizado (upvotes - downvotes)
  commentCount Int       @default(0) // denormalizado
  nsfw         Boolean   @default(false)
  pinned       Boolean   @default(false)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  votes     Vote[]
  comments  Comment[]
  reactions Reaction[]
  tags      PostTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status, createdAt])
  @@index([type, status, score])
  @@index([categoryId])
}

model Vote {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  voterToken String
  value      Int // +1 / -1
  createdAt  DateTime @default(now())

  @@unique([postId, voterToken])
  @@index([postId])
}

model Reaction {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  voterToken String
  emoji      String // "😂" "❤️" "😮" "🔥"
  createdAt  DateTime @default(now())

  @@unique([postId, voterToken, emoji])
  @@index([postId])
}

model Comment {
  id          String    @id @default(cuid())
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Comment?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("Thread")
  authorName  String    @default("Anónimo")
  authorToken String
  body        String
  score       Int       @default(0)
  status      ModStatus @default(PUBLISHED)
  createdAt   DateTime  @default(now())

  commentVotes CommentVote[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  visitor   String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model SiteSettings {
  id            String   @id @default("singleton")
  bannerEnabled Boolean  @default(true)
  bannerText    String   @default("¡Síguenos en redes y no te pierdas nada de Goals Ec!")
  facebookUrl   String?
  instagramUrl  String?
  tiktokUrl     String?
  youtubeUrl    String?
  xUrl          String?
  whatsappUrl   String?

  popupEnabled  Boolean @default(false)
  popupTitle    String?
  popupBody     String?
  popupImage    String?
  popupCtaLabel String?
  popupCtaUrl   String?

  // SEO / OpenGraph globales
  seoTitle       String?
  seoDescription String?
  ogImage        String?

  // Analytics y anuncios
  analyticsId    String? // Google Analytics (ej. G-XXXXXXXXXX)
  adsenseClient  String? // AdSense (ej. ca-pub-XXXXXXXXXXXXXXXX)

  // Segundo banner (marcas / perfiles)
  secondBannerEnabled Boolean @default(false)
  secondBannerColor   String  @default("#1d4ed8")
  goalsUrl       String?
  tulcanenoUrl   String?
  stevenUrl      String?
  ecuatorianoUrl String?

  updatedAt     DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CommentVote {
  id         String   @id @default(cuid())
  commentId  String
  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  voterToken String
  value      Int // +1 / -1
  createdAt  DateTime @default(now())

  @@unique([commentId, voterToken])
  @@index([commentId])
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

// ─────────────────────────────────────────────────────────────
// Pronósticos deportivos + sorteos (requiere registro)
// ─────────────────────────────────────────────────────────────

model Participant {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  points       Int      @default(0) // boletos acumulados (denormalizado)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  predictions Prediction[]
  rafflesWon  Raffle[]

  @@index([points])
}

enum MatchStatus {
  OPEN // admite pronósticos
  CLOSED // cerrado, esperando resultado
  SETTLED // resultado cargado y puntos repartidos
}

model Match {
  id        String      @id @default(cuid())
  homeTeam  String
  awayTeam  String
  league    String?
  kickoff   DateTime
  status    MatchStatus @default(OPEN)
  homeScore Int?
  awayScore Int?

  predictions Prediction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, kickoff])
}

model Prediction {
  id            String @id @default(cuid())
  matchId       String
  match         Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  homeScore Int
  awayScore Int
  points    Int @default(0) // puntos obtenidos tras liquidar el partido

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, participantId])
  @@index([participantId])
}

enum RaffleStatus {
  OPEN
  CLOSED
  DRAWN
}

model Raffle {
  id          String       @id @default(cuid())
  title       String
  description String?
  prize       String
  status      RaffleStatus @default(OPEN)

  winnerId      String?
  winner        Participant? @relation(fields: [winnerId], references: [id])
  winnerName    String?
  winnerTickets Int?
  totalTickets  Int?
  drawnAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
